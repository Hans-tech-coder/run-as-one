generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Organizer {
  id         String      @id @default(cuid())
  email      String      @unique
  password   String
  name       String
  role       String      @default("ORGANIZER")
  status     String      @default("PENDING")
  /// Centavos. 6000 = ₱60.00
  adminFee   Int         @default(6000)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  events     Event[]
  promoCodes PromoCode[]
}

model Event {
  id                     String         @id @default(cuid())
  title                  String
  date                   String
  location               String
  imageUrl               String
  description            String?
  logisticsPickup        Boolean        @default(true)
  /// Centavos
  logisticsDeliveryFee   Int            @default(0)
  organizerId            String
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt
  endTime                String?
  raceKitImageUrl        String?
  startTime              String?
  certificateCoordinates String?
  certificateTemplate    String?
  categories             Category[]
  organizer              Organizer      @relation(fields: [organizerId], references: [id])
  raceResults            RaceResult[]
  registrations          Registration[]
}

model Category {
  id          String       @id @default(cuid())
  name        String
  distance    String
  /// Centavos
  price       Int
  eventId     String
  event       Event        @relation(fields: [eventId], references: [id])
  raceResults RaceResult[]
  runners     Runner[]
}

model Registration {
  id                String   @id @default(cuid())
  eventId           String
  orderRef          String   @unique
  customerEmail     String
  customerName      String
  customerPhone     String?
  logisticsMethod   String
  deliveryAddress   String?
  /// All amounts below are centavos
  deliveryFee       Int      @default(0)
  subtotal          Int
  platformFee       Int      @default(0)
  transactionFee    Int      @default(0)
  totalAmount       Int
  status            String   @default("PAID")
  paymentMethod     String   @default("online")
  checkoutSessionId String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  proofOfPayment    String?
  transactionNumber String?
  event             Event    @relation(fields: [eventId], references: [id])
  runners           Runner[]
}

model Runner {
  id                    String       @id @default(cuid())
  registrationId        String
  categoryId            String
  firstName             String
  lastName              String
  email                 String
  phone                 String
  gender                String
  birthdate             String
  singletSize           String
  emergencyContactName  String
  emergencyContactPhone String
  medicalConditions     String?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
  category              Category     @relation(fields: [categoryId], references: [id])
  registration          Registration @relation(fields: [registrationId], references: [id])
}

model PromoCode {
  id            String    @id @default(cuid())
  code          String    @unique
  discountType  String
  /// Unit depends on discountType: FIXED = centavos, PERCENTAGE = basis points (1000 = 10%)
  discountValue Int
  usageLimit    Int?
  usageCount    Int       @default(0)
  validFrom     DateTime?
  validUntil    DateTime?
  organizerId   String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  organizer     Organizer @relation(fields: [organizerId], references: [id])
}

model RaceResult {
  id           String   @id @default(cuid())
  eventId      String
  categoryId   String
  bibNumber    String
  name         String
  gender       String
  chipTime     String
  chipTimeSecs Int
  gunTime      String?
  overallRank  Int
  genderRank   Int
  categoryRank Int
  status       String   @default("FINISHED")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  category     Category @relation(fields: [categoryId], references: [id])
  event        Event    @relation(fields: [eventId], references: [id])

  @@unique([eventId, bibNumber])
}
