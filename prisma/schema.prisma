generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Organizer {
  id         String      @id @default(cuid())
  email      String      @unique
  password   String
  name       String
  role       String      @default("ORGANIZER")
  status     String      @default("PENDING")
  /// Centavos. 6000 = ₱60.00
  adminFee   Int         @default(6000)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  events     Event[]
  promoCodes PromoCode[]
}

model Event {
  id                          String         @id @default(cuid())
  title                       String
  /// The event's segment in its public URL, derived from the title so a link
  /// says what it points at. Unique because two organizers will eventually
  /// both run a "Fun Run"; see src/lib/event-slug.ts.
  slug                        String         @unique
  date                        String
  location                    String
  imageUrl                    String
  description                 String?
  logisticsPickup             Boolean        @default(true)
  /// Where a race kit is collected when the runner picks pickup, in the
  /// organizer's own words ("Toby's Sports, SM Clark, 2nd floor"). Null falls
  /// back to standard wording — see src/lib/pickup.ts. It is shown on the
  /// pickup card itself, because a runner choosing pickup needs the address
  /// at the moment they choose it, not in a follow-up email.
  pickupLocation              String?
  /// When that pickup window is open ("March 12-14, 10AM-7PM"). Separate from
  /// the location because an organizer often knows one before the other.
  pickupSchedule              String?
  /// Centavos. Delivery within the event's province. 0 = tier not offered.
  logisticsDeliveryFeeInside  Int            @default(0)
  /// Centavos. Delivery outside the event's province. 0 = tier not offered.
  logisticsDeliveryFeeOutside Int            @default(0)
  /// Centavos, charged per runner. 6000 = ₱60.00
  adminFee                    Int            @default(6000)
  /// Centavos, charged once per runner whose shirt size is 4XL or above,
  /// because the larger sizes cost the organizer more to produce. 0 disables
  /// the surcharge. 10000 = ₱100.00, which is what the printed forms quote.
  shirtSizeUpcharge           Int            @default(10000)
  /// The liability, media, and data-privacy waiver shown above the consent
  /// checkbox, one string per paragraph. Empty means the organizer never wrote
  /// their own, and the standard wording is used instead — see
  /// resolveConsentWaiver. Never present an empty waiver.
  consentWaiver               String[]       @default([])
  /// Which checkout the runner sees: "ONLINE" (PayMongo + bank transfer) or
  /// "BANK_TRANSFER" (bank transfer only).
  registrationForm            String         @default("ONLINE")
  /// What the event sells: "RACE" (distance categories) or "FUN_RUN"
  /// (inclusion packages, no distances).
  eventType                   String         @default("RACE")
  /// A manual hold on sign-ups, set by the organizer. Distinct from a race
  /// that is over and from an event whose every option has sold out: those
  /// two are facts the app works out for itself, this one is a decision — the
  /// slots and the days both remain, and the organizer has stopped anyway.
  registrationPaused          Boolean        @default(false)
  /// What runners are told while the hold is on, in the organizer's own words
  /// ("Registration reopens once the new singlets arrive"). Null falls back to
  /// the standard sentence — see src/lib/registration-gate.ts. Never left
  /// unexplained: a runner turned away deserves a reason.
  registrationPauseNote       String?
  /// The instant sign-ups open, for an event listed before it is ready to take
  /// them. Null is the normal case and means "already open": an event is
  /// registrable the moment it is published. A time in the future lists the
  /// race publicly — so runners can see it is coming and plan for it — while
  /// the register button is held back until this passes, at which point it
  /// opens on its own with nobody having to press anything.
  ///
  /// A DateTime rather than the calendar-day string `date` uses, because this
  /// one is an instant: "8 AM on the 20th" is a moment sign-ups start, not a
  /// day they happen on. Written and read in Asia/Manila — see
  /// src/lib/event-schedule.ts.
  registrationOpensAt         DateTime?
  organizerId                 String
  createdAt                   DateTime       @default(now())
  updatedAt                   DateTime       @updatedAt
  endTime                     String?
  raceKitImageUrl             String?
  startTime                   String?
  certificateCoordinates      String?
  certificateTemplate         String?
  bankAccounts                BankAccount[]
  categories                  Category[]
  organizer                   Organizer      @relation(fields: [organizerId], references: [id])
  promoCodes                  PromoCode[]
  raceResults                 RaceResult[]
  registrations               Registration[]
}

/// One account a runner can transfer to for this event.
///
/// Per event rather than per organizer or hardcoded: an organizer may collect
/// a charity run into a different account than their usual one, and the
/// accounts used to be a constant in the bundle, which meant every event
/// pointed runners at the same three banks no matter whose event it was.
model BankAccount {
  id            String   @id @default(cuid())
  /// What the runner will recognise: "BDO Unibank", "GCash", "Maya".
  bankName      String
  /// Whose account it is, as the bank prints it.
  accountName   String
  /// Kept exactly as typed, spacing and all — a runner copies this by hand.
  accountNumber String
  /// Optional QR to scan, uploaded like every other image here. Null is normal:
  /// plenty of accounts have no QR, and the numbers alone are enough to pay.
  qrImageUrl    String?
  /// The order the runner sees them in.
  sortOrder     Int      @default(0)
  eventId       String
  event         Event    @relation(fields: [eventId], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([eventId, sortOrder])
}

model Category {
  id          String       @id @default(cuid())
  name        String
  /// "42K" for a race. Empty for a fun run package, which has no distance.
  distance    String
  /// Centavos
  price       Int
  /// Poster showing what a package includes. Races leave this null.
  imageUrl    String?
  /// How many runners this option can take. Null means uncapped, which is what
  /// every option was before limits existed. The cap belongs here rather than
  /// on the Event because a 10K filling up says nothing about the 5K beside
  /// it: the event closes only once every option has.
  slotLimit   Int?
  /// What this option gets you — "Race Singlet", "Finisher Medal". Per category
  /// rather than per event, because a 10K and a 5K rarely include the same
  /// things. Empty means the event page shows no inclusions block.
  inclusions  String[]     @default([])
  /// Where this option sits in the event's list, fixed when it is created:
  /// the first option the organizer entered stays first however often the
  /// event is edited, and one added later joins the end. Without it the list
  /// came back in Postgres's physical row order, which an UPDATE rewrites —
  /// saving the event moved every edited option to the bottom. Read through
  /// CATEGORY_ORDER in src/lib/category-order.ts, never ordered by hand.
  sortOrder   Int          @default(0)
  eventId     String
  event       Event        @relation(fields: [eventId], references: [id])
  raceResults RaceResult[]
  runners     Runner[]
  /// The promotions that put this option on a lower price -- see
  /// PromoCategoryPrice.
  promoPrices PromoCategoryPrice[]
}

model Registration {
  id                String    @id @default(cuid())
  eventId           String
  orderRef          String    @unique
  customerEmail     String
  customerName      String
  customerPhone     String?
  logisticsMethod   String
  /// "inside" or "outside" province, when logisticsMethod is "delivery".
  /// The runner's own declaration — it decides which fee was charged.
  deliveryZone      String?
  deliveryAddress   String?
  /// All amounts below are centavos
  deliveryFee       Int       @default(0)
  subtotal          Int
  platformFee       Int       @default(0)
  transactionFee    Int       @default(0)
  totalAmount       Int
  /// What the promo code took off, in centavos, and which code it was. The
  /// amount is stored rather than recomputed on read: a code's percentage can
  /// be edited or the code deleted outright, and a receipt has to keep saying
  /// what this runner was actually charged.
  ///
  /// The code is a snapshot of the text, not a relation, for the same reason
  /// runningCommunity is: it is what was quoted on the day, and it must keep
  /// reading correctly after the PromoCode row is gone. 0 and null are the
  /// normal case -- most orders carry no discount at all.
  discountAmount    Int       @default(0)
  promoCode         String?
  /// Which kind of promotion it was -- "CATEGORY_PRICE" or "BUY_X_GET_Y" --
  /// snapshotted for the same reason promoCode is, and needed for a reason
  /// promoCode alone cannot serve: the receipt has to know whether the
  /// discount was a *price* or a *deduction*.
  ///
  /// A sale is shown as the price itself (subtotal already net, no discount
  /// row); every other kind is a line off the order. The email renders from
  /// this row long after checkout, and the PromoCode it came from may have
  /// been edited or deleted by then, so reading the kind back off the
  /// promotion is not available -- see isPricedIn in src/lib/discount.ts.
  ///
  /// Null on the orders that carry no discount, and on every order written
  /// before this column existed.
  discountType      String?
  /// PAID, PENDING, CANCELLED, REFUNDED or EXPIRED -- guarded against that
  /// list wherever it is written (see api/admin/registrations/[id]/status).
  ///
  /// EXPIRED is not a synonym for CANCELLED. CANCELLED is a decision somebody
  /// made about an order; EXPIRED is an online checkout nobody ever came back
  /// to finish, swept by src/lib/pending-expiry.ts. The registrants screen has
  /// to be able to tell an organizer which of the two it is looking at, and a
  /// shared word would have made that impossible after the fact.
  ///
  /// Only PAID and PENDING hold a slot (see lib/registration-gate.ts), so the
  /// sweep releases the seat by the act of changing this column.
  status            String    @default("PAID")
  /// When the sweep expired this order. Null on every row that was never
  /// swept, which is almost all of them.
  ///
  /// It exists for two reasons. It makes the sweep auditable -- an organizer
  /// asking why a registration went away has a timestamp rather than a guess
  /// -- and it is the mark that stops a row being expired twice, which matters
  /// because expiring also hands a promo redemption back and a second pass
  /// would hand back a redemption that was never spent.
  expiredAt         DateTime?
  paymentMethod     String    @default("online")
  checkoutSessionId String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  proofOfPayment    String?
  transactionNumber String?
  /// Whether the customer checked the liability & data-privacy consent box at
  /// submission. false on registrations made before this was required, since
  /// they were never actually asked — not a claim that they refused.
  consentGiven      Boolean   @default(false)
  /// When consentGiven was recorded. Null whenever consentGiven is false.
  consentGivenAt    DateTime?
  /// The full name the person submitting typed as their digital signature,
  /// stored UPPERCASE like every other registrant field. A tick records only
  /// that a box was clicked; a name typed by hand is the thing an organizer
  /// can hold up afterwards and say who agreed.
  ///
  /// It has to match one of the runners on this order (see
  /// lib/consent-signature.ts) rather than any name at all -- one member of a
  /// group registers for everyone, so demanding the *first* runner would stop
  /// whoever is actually doing the paperwork. Null on registrations made
  /// before this was asked for: they were never asked, which is not the same
  /// as having refused.
  consentSignature  String?
  /// What the organizer's payment validator wrote about this order, and who
  /// wrote it when. Internal only -- the runner never sees it and no email
  /// goes out; an assigned staff member reaches out by hand. It is where
  /// "deposit slip is for the wrong amount" lives, so the next person to open
  /// the row does not start the same phone call over again.
  remarks           String?
  /// Who last wrote the remarks, stored as their name rather than a relation
  /// to the account: it is a line in a log, and it has to keep reading
  /// correctly if that account is later removed.
  remarksBy         String?
  remarksAt         DateTime?
  /// When each of the two transactional emails actually reached the runner --
  /// null means it never did. Resend's free tier is 100 recipients a day and
  /// stops rather than bills, so a send can simply not happen; before these
  /// columns existed sendEmail() logged the failure and returned void, and a
  /// registration could sit unconfirmed with nothing on the row to say so.
  ///
  /// "received" is owed by every registration; "confirmation" only once the
  /// status reaches PAID. A hand-sent email stamps the same column, because
  /// what these record is that the runner *has* the email, not which system
  /// delivered it -- see src/lib/email-delivery.ts.
  receivedEmailSentAt     DateTime?
  confirmationEmailSentAt DateTime?
  /// Resend's own reason for the last failure, kept so a quota stop ("daily
  /// limit reached") is distinguishable from a bad address at a glance. It is
  /// diagnostic text for the organizer, not a coded column.
  lastEmailError          String?
  /// The staff member who sent an outstanding email by hand, and when. Their
  /// name rather than an account id, like remarksBy: it is a line in a log and
  /// has to keep reading correctly after an account is removed.
  manualEmailSentAt       DateTime?
  manualEmailSentBy       String?
  event             Event     @relation(fields: [eventId], references: [id])
  runners           Runner[]
}

model Runner {
  id                    String       @id @default(cuid())
  registrationId        String
  /// Which runner on this order, 1..n — the tail of the reference this person
  /// quotes back at us ("RM-D918005C-2"; see src/lib/order-ref.ts). One
  /// orderRef covers a whole group, so without this three colleagues who
  /// registered together have no way to say which of them they are.
  ///
  /// Stored rather than derived from row order: createMany does not guarantee
  /// read-back order, and a reference that changes between two page loads is
  /// worse than none. No default — the position is the checkout route's to
  /// assign, and a default would quietly make everyone runner 1.
  runnerNo              Int
  categoryId            String
  firstName             String
  lastName              String
  email                 String
  phone                 String
  gender                String
  birthdate             String
  singletSize           String
  /// Centavos this runner's category was charged at, when a repricing
  /// promotion gave them a seat at its price -- null when they paid the
  /// category's own price, which is every runner on every other kind of order.
  ///
  /// Per runner rather than per order because a promotion can run out halfway
  /// through one: a group of three on a 10K with two seats left has two
  /// runners at P900 and one at P1,200, and an order-level column could only
  /// record one of those.
  ///
  /// It is a snapshot, like Registration.promoCode, so editing or deleting the
  /// promotion cannot rewrite what somebody was charged -- and it is what the
  /// abandoned-checkout sweep counts to hand the right number of seats back
  /// (src/lib/pending-expiry.ts). Recomputing that from the promotion instead
  /// would hand back three seats for an order that only ever took two.
  promoPrice            Int?
  emergencyContactName  String
  emergencyContactPhone String
  medicalConditions     String?
  /// The club this runner represents. Free text rather than a relation to
  /// RunningCommunity on purpose: it is what they answered on the day, and it
  /// must not change if the super admin later renames or removes that club.
  /// Blank answers are stored as "INDEPENDENT RUNNER", itself a listed option.
  runningCommunity      String       @default("INDEPENDENT RUNNER")
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
  category              Category     @relation(fields: [categoryId], references: [id])
  registration          Registration @relation(fields: [registrationId], references: [id])

  /// Slot limits are counted by grouping these rows per category, on every
  /// event page and every public listing. Postgres does not index a foreign
  /// key on its own, so without this the count is a sequential scan of every
  /// runner the platform has ever taken.
  @@index([categoryId])

  /// Two runners sharing "-2" on the same order would hand two people the
  /// same reference, which is the ambiguity runnerNo exists to remove.
  @@unique([registrationId, runnerNo])
}

/// The running clubs a runner can pick from at sign-up. One master list across
/// every event, because the same clubs turn up race after race.
model RunningCommunity {
  id        String   @id @default(cuid())
  /// Display name, exactly as the runner will see it in the picker.
  name      String
  /// Uppercased `name`, which is what uniqueness is enforced on. Stored rather
  /// than derived so the database itself can reject "Team Army" joining a list
  /// that already has "TEAM ARMY".
  slug      String   @unique
  /// "APPROVED" appears in the runner-facing pickers. "PENDING" is a runner's
  /// write-in that only the super admin has seen. Rejecting one deletes it.
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, name])
}

/// A discount an organizer can hand out, redeemed by a runner at checkout.
///
/// Codes used to be organizer-wide and were never wired into checkout at all,
/// which made them admin bookkeeping rather than a discount. Both halves are
/// now real: a code belongs to one event (or to every event the organizer
/// runs), and the checkout routes recompute its value from this row rather
/// than trusting an amount the browser sent -- exactly as they already do with
/// the subtotal and the fees. See src/lib/discount.ts.
model PromoCode {
  id            String    @id @default(cuid())
  /// What the runner types at checkout -- or, when `automatic` is set, the
  /// promotion's own name, since there is nothing to type. One column for both
  /// because both answer the same question: what do we call this promotion
  /// when we show it to a runner. Uppercase like every other coded column, and
  /// spaces are allowed, so "EARLY BIRD" reads correctly on a badge.
  code          String
  /// "CATEGORY_PRICE" | "BUY_X_GET_Y" -- uppercase like every other coded
  /// column, and guarded by asDiscountType at the API door.
  discountType  String
  /// Kept at 0 by both surviving kinds and read by neither: CATEGORY_PRICE
  /// takes its amounts from the categoryPrices rows below and BUY_X_GET_Y from
  /// buyQuantity/getQuantity. The column stays because it is the one place a
  /// future kind whose worth is a single number would put it, and dropping it
  /// would cost a migration to add back.
  discountValue Int
  /// How many times this code may be redeemed in total. Null = unlimited. A
  /// single-use voucher is simply a limit of 1, which is why there is no
  /// separate flag: "used once" is a cap, and the cap already exists.
  ///
  /// A promotion is limited **either** by this count **or** by the window
  /// below, never by both, and the marketing form makes that an explicit
  /// choice -- see promo-input.ts. There is no column recording which was
  /// chosen because the rows already say it: a usageLimit means the count, and
  /// its absence means the window (or nothing at all). A voucher batch is the
  /// one exception, since every voucher carries a limit of 1 by construction.
  usageLimit    Int?
  usageCount    Int       @default(0)
  validFrom     DateTime?
  validUntil    DateTime?
  /// The event this code is for. Null means every event this organizer runs,
  /// which is what every code created before scoping existed was.
  eventId       String?
  /// BUY_X_GET_Y only: buy this many at full price and get that many free.
  /// "Register 5, the 6th is free" is buyQuantity 5, getQuantity 1.
  buyQuantity   Int?
  getQuantity   Int?
  /// The batch a bulk-generated voucher was born in ("SUMMER VIP"), so two
  /// hundred single-use codes read as one promotion in the admin instead of
  /// two hundred unrelated rows. Null for a code created on its own.
  batchLabel    String?
  /// A promotion that needs no code: it applies on its own to any order that
  /// meets its conditions. This is what an early bird is -- a discount tied to
  /// a date rather than to something the runner had to be told about. It is
  /// deliberately not offered in the promo box either, since a runner typing
  /// "EARLY BIRD" is not how it is meant to be claimed and it is already on
  /// their order. Where two promotions both apply, only the larger one does --
  /// see bestDiscount in src/lib/discount.ts.
  automatic     Boolean   @default(false)
  /// The organizer's hand on the switch, exactly like Event.registrationPaused
  /// and for the same reason: a promotion that has run out, expired or not
  /// started yet is a fact the app works out for itself, and this one is a
  /// decision -- the dates and the redemptions both remain, and the organizer
  /// has stopped it anyway.
  ///
  /// It is what an organizer reaches for instead of deleting: a code printed
  /// on a poster can be switched off and back on, while deleting it leaves a
  /// runner typing a code nobody can explain.
  paused        Boolean   @default(false)
  organizerId   String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  event         Event?    @relation(fields: [eventId], references: [id])
  organizer     Organizer @relation(fields: [organizerId], references: [id])
  /// CATEGORY_PRICE only: the discounted price this promotion puts each
  /// category on. Empty for every other kind.
  categoryPrices PromoCategoryPrice[]

  /// Unique per organizer rather than globally. A code is now looked up
  /// through the event a runner is registering for, so we always know whose it
  /// is -- and a global constraint meant the second organizer to think of
  /// "EARLYBIRD" could not have it.
  @@unique([organizerId, code])
  @@index([eventId])
  @@index([organizerId, batchLabel])
  /// Every event page and both wizards ask for this organizer's automatic
  /// promotions on load, which is the one promo query that runs on a public
  /// page and so the one that has to stay cheap.
  @@index([organizerId, automatic])
}

/// One category put on a lower price by one promotion.
///
/// A CATEGORY_PRICE promotion is not a share or a flat amount off the order --
/// it is a second price list for one race, so the 10K can be cut from P1,200 to
/// P900 while the 5K stays where it is. That is a value per category, which is
/// a row per category rather than a column on PromoCode.
///
/// **Only the discounted price is stored.** The price it is discounted *from*
/// is Category.price, read live, so an organizer who later raises the 10K does
/// not leave a promotion quoting a struck-through number the event page no
/// longer charges. What the runner sees slashed is always the category's own
/// price today.
///
/// Cascades on both sides: the prices are part of the promotion, and a category
/// that no longer exists has no price to discount.
model PromoCategoryPrice {
  id          String    @id @default(cuid())
  promoCodeId String
  categoryId  String
  /// Centavos. Below Category.price, and validated as such at the API door --
  /// a "discount" that costs more is a price rise nobody meant to publish.
  price       Int
  /// How many **runners** may take this price, or null for as many as come.
  ///
  /// Runners rather than orders, unlike PromoCode.usageLimit, and the
  /// difference is the point: this is a number of seats at a price, the same
  /// thing Category.slotLimit counts, so a group of three eats three of them.
  /// An early bird capped at 50 orders could be claimed by 50 groups of four.
  ///
  /// It sits here rather than on PromoCode because that is the whole request:
  /// 50 at the promo price on the 10K and 30 on the 5K are two different
  /// decisions, and one column could only ever hold one of them.
  usageLimit  Int?
  /// Runners already sold at this price. Incremented inside the checkout
  /// transaction by redeemPromoCode, under the same FOR UPDATE lock
  /// reserveSlots takes, since a cap checked before the write is a cap two
  /// simultaneous orders both pass.
  usageCount  Int       @default(0)
  promo       PromoCode @relation(fields: [promoCodeId], references: [id], onDelete: Cascade)
  category    Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  /// One price per category per promotion: a promotion cannot quote the 10K
  /// twice and leave the checkout to pick.
  @@unique([promoCodeId, categoryId])
  @@index([categoryId])
}

model RaceResult {
  id           String   @id @default(cuid())
  eventId      String
  categoryId   String
  bibNumber    String
  name         String
  gender       String
  chipTime     String
  chipTimeSecs Int
  gunTime      String?
  overallRank  Int
  genderRank   Int
  categoryRank Int
  status       String   @default("FINISHED")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  category     Category @relation(fields: [categoryId], references: [id])
  event        Event    @relation(fields: [eventId], references: [id])

  @@unique([eventId, bibNumber])
}
