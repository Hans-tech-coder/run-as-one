generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// Run As One itself — the one tenant. Since ADMIN_MERGE_PLAN.md every event,
/// promotion, staff membership and audit row belongs to this row, and it is the
/// only Organizer that signs in (`RUN_AS_ONE_ORGANIZER_ID`,
/// src/lib/organizer-status.ts). The organizations races are run for are
/// `Client` rows. The table kept its name and shape rather than being folded
/// away, because every tenant check in the app scopes by `organizerId`.
model Organizer {
  id                String            @id @default(cuid())
  email             String            @unique
  password          String
  name              String
  /// "ORGANIZER" on every row since the super admin account was retired
  /// (ADMIN_MERGE_PLAN.md, Batch 5). Nothing reads it; kept by the owner's call.
  role              String            @default("ORGANIZER")
  /// Only APPROVED can be signed in to — src/lib/organizer-status.ts, an
  /// allowlist. Plain text so a status can be added without a migration.
  status            String            @default("PENDING")
  /// Centavos. The **default platform fee** (lib/platform-fee.ts): what a new
  /// event's Admin Fee starts at, set by the Super Admin on /admin/settings.
  /// Never charged itself — every order's fee comes from `Event.adminFee`.
  adminFee          Int               @default(6000)
  /// The owner's profile photo, a public blob URL (avatars/ in the public
  /// store), set from /admin/settings. Null shows the name's initial instead.
  avatarUrl         String?
  /// When the owner last signed in, shown under Sign-in Activity on
  /// /admin/settings. Null until the first sign-in after it was added.
  lastLoginAt       DateTime?
  /// Every owner session issued before this instant is dead (lib/actor.ts).
  /// Moved forward by "Sign out other devices" and by a password change.
  /// Nullable, unlike StaffAccount's, so adding it signed nobody out: null
  /// means no session has ever been ended.
  sessionsValidFrom DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  events            Event[]
  promoCodes        PromoCode[]
  /// The people who work inside this organizer besides its owner. The owner is
  /// this row's own email and password and is never a membership — see
  /// StaffAccount for why the tenant and the person are separate.
  staff             StaffMembership[]
}

model Event {
  id                          String            @id @default(cuid())
  title                       String
  /// The event's segment in its public URL, derived from the title so a link
  /// says what it points at. Unique because two organizers will eventually
  /// both run a "Fun Run"; see src/lib/event-slug.ts.
  slug                        String            @unique
  date                        String
  location                    String
  imageUrl                    String
  description                 String?
  logisticsPickup             Boolean           @default(true)
  /// Where a race kit is collected when the runner picks pickup, in the
  /// organizer's own words ("Toby's Sports, SM Clark, 2nd floor"). Null falls
  /// back to standard wording — see src/lib/pickup.ts. It is shown on the
  /// pickup card itself, because a runner choosing pickup needs the address
  /// at the moment they choose it, not in a follow-up email.
  pickupLocation              String?
  /// When that pickup window is open ("March 12-14, 10AM-7PM"). Separate from
  /// the location because an organizer often knows one before the other.
  pickupSchedule              String?
  /// Centavos. Delivery within the event's province. 0 = tier not offered.
  logisticsDeliveryFeeInside  Int               @default(0)
  /// Centavos. Delivery outside the event's province. 0 = tier not offered.
  logisticsDeliveryFeeOutside Int               @default(0)
  /// Centavos, charged per runner. 6000 = ₱60.00
  adminFee                    Int               @default(6000)
  /// Centavos, charged once per runner whose shirt size is 4XL or above,
  /// because the larger sizes cost the organizer more to produce. 0 disables
  /// the surcharge. 10000 = ₱100.00, which is what the printed forms quote.
  shirtSizeUpcharge           Int               @default(10000)
  /// The liability, media, and data-privacy waiver shown above the consent
  /// checkbox, one string per paragraph. Empty means the organizer never wrote
  /// their own, and the standard wording is used instead — see
  /// resolveConsentWaiver. Never present an empty waiver.
  consentWaiver               String[]          @default([])
  /// Which checkout the runner sees: "ONLINE" (PayMongo + bank transfer) or
  /// "BANK_TRANSFER" (bank transfer only).
  registrationForm            String            @default("ONLINE")
  /// What the event sells: "RACE" (distance categories) or "FUN_RUN"
  /// (inclusion packages, no distances).
  eventType                   String            @default("RACE")
  /// A manual hold on sign-ups, set by the organizer. Distinct from a race
  /// that is over and from an event whose every option has sold out: those
  /// two are facts the app works out for itself, this one is a decision — the
  /// slots and the days both remain, and the organizer has stopped anyway.
  registrationPaused          Boolean           @default(false)
  /// What runners are told while the hold is on, in the organizer's own words
  /// ("Registration reopens once the new singlets arrive"). Null falls back to
  /// the standard sentence — see src/lib/registration-gate.ts. Never left
  /// unexplained: a runner turned away deserves a reason.
  registrationPauseNote       String?
  /// The instant sign-ups open, for an event listed before it is ready to take
  /// them. Null is the normal case and means "already open": an event is
  /// registrable the moment it is published. A time in the future lists the
  /// race publicly — so runners can see it is coming and plan for it — while
  /// the register button is held back until this passes, at which point it
  /// opens on its own with nobody having to press anything.
  ///
  /// A DateTime rather than the calendar-day string `date` uses, because this
  /// one is an instant: "8 AM on the 20th" is a moment sign-ups start, not a
  /// day they happen on. Written and read in Asia/Manila — see
  /// src/lib/event-schedule.ts.
  registrationOpensAt         DateTime?
  organizerId                 String
  /// Which client this race is run for (ADMIN_MERGE_PLAN.md). Null means it
  /// has not been linked yet — every event that existed before clients did,
  /// until staff link it by hand. A client viewer reaches only the events that
  /// name its client, so a null here is invisible to every viewer.
  clientId                    String?
  client                      Client?           @relation(fields: [clientId], references: [id])
  createdAt                   DateTime          @default(now())
  updatedAt                   DateTime          @updatedAt
  endTime                     String?
  raceKitImageUrl             String?
  startTime                   String?
  certificateCoordinates      String?
  certificateTemplate         String?
  bankAccounts                BankAccount[]
  categories                  Category[]
  organizer                   Organizer         @relation(fields: [organizerId], references: [id])
  promoCodes                  PromoCode[]
  raceResults                 RaceResult[]
  registrations               Registration[]
  /// The staff who may touch this race, and as what. OWNER and ADMIN reach
  /// every event without one; a STAFF membership reaches only these.
  assignments                 EventAssignment[]
  /// What Run As One has paid the organizer out of this race's collections
  /// (ADMIN_MERGE_PLAN.md, Batch 6). An event with any row here cannot be
  /// deleted: the payout record outlives nothing it describes.
  remittances                 Remittance[]
}

/// One account a runner can transfer to for this event.
///
/// Per event rather than per organizer or hardcoded: an organizer may collect
/// a charity run into a different account than their usual one, and the
/// accounts used to be a constant in the bundle, which meant every event
/// pointed runners at the same three banks no matter whose event it was.
model BankAccount {
  id            String   @id @default(cuid())
  /// What the runner will recognise: "BDO Unibank", "GCash", "Maya".
  bankName      String
  /// Whose account it is, as the bank prints it.
  accountName   String
  /// Kept exactly as typed, spacing and all — a runner copies this by hand.
  accountNumber String
  /// Optional QR to scan, uploaded like every other image here. Null is normal:
  /// plenty of accounts have no QR, and the numbers alone are enough to pay.
  qrImageUrl    String?
  /// The order the runner sees them in.
  sortOrder     Int      @default(0)
  eventId       String
  event         Event    @relation(fields: [eventId], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([eventId, sortOrder])
}

model Category {
  id          String               @id @default(cuid())
  name        String
  /// "42K" for a race. Empty for a fun run package, which has no distance.
  distance    String
  /// Centavos
  price       Int
  /// Poster showing what a package includes. Races leave this null.
  imageUrl    String?
  /// How many runners this option can take. Null means uncapped, which is what
  /// every option was before limits existed. The cap belongs here rather than
  /// on the Event because a 10K filling up says nothing about the 5K beside
  /// it: the event closes only once every option has.
  slotLimit   Int?
  /// What this option gets you — "Race Singlet", "Finisher Medal". Per category
  /// rather than per event, because a 10K and a 5K rarely include the same
  /// things. Empty means the event page shows no inclusions block.
  inclusions  String[]             @default([])
  /// Where this option sits in the event's list, fixed when it is created:
  /// the first option the organizer entered stays first however often the
  /// event is edited, and one added later joins the end. Without it the list
  /// came back in Postgres's physical row order, which an UPDATE rewrites —
  /// saving the event moved every edited option to the bottom. Read through
  /// CATEGORY_ORDER in src/lib/category-order.ts, never ordered by hand.
  sortOrder   Int                  @default(0)
  eventId     String
  event       Event                @relation(fields: [eventId], references: [id])
  raceResults RaceResult[]
  runners     Runner[]
  /// The promotions that put this option on a lower price -- see
  /// PromoCategoryPrice.
  promoPrices PromoCategoryPrice[]
}

model Registration {
  id                      String    @id @default(cuid())
  eventId                 String
  orderRef                String    @unique
  customerEmail           String
  customerName            String
  customerPhone           String?
  logisticsMethod         String
  /// "inside" or "outside" province, when logisticsMethod is "delivery".
  /// The runner's own declaration — it decides which fee was charged.
  deliveryZone            String?
  deliveryAddress         String?
  /// All amounts below are centavos
  deliveryFee             Int       @default(0)
  subtotal                Int
  platformFee             Int       @default(0)
  transactionFee          Int       @default(0)
  totalAmount             Int
  /// What the promo code took off, in centavos, and which code it was. The
  /// amount is stored rather than recomputed on read: a code's percentage can
  /// be edited or the code deleted outright, and a receipt has to keep saying
  /// what this runner was actually charged.
  ///
  /// The code is a snapshot of the text, not a relation, for the same reason
  /// runningCommunity is: it is what was quoted on the day, and it must keep
  /// reading correctly after the PromoCode row is gone. 0 and null are the
  /// normal case -- most orders carry no discount at all.
  discountAmount          Int       @default(0)
  promoCode               String?
  /// Which kind of promotion it was -- "CATEGORY_PRICE" or "BUY_X_GET_Y" --
  /// snapshotted for the same reason promoCode is, and needed for a reason
  /// promoCode alone cannot serve: the receipt has to know whether the
  /// discount was a *price* or a *deduction*.
  ///
  /// A sale is shown as the price itself (subtotal already net, no discount
  /// row); every other kind is a line off the order. The email renders from
  /// this row long after checkout, and the PromoCode it came from may have
  /// been edited or deleted by then, so reading the kind back off the
  /// promotion is not available -- see isPricedIn in src/lib/discount.ts.
  ///
  /// Null on the orders that carry no discount, and on every order written
  /// before this column existed.
  discountType            String?
  /// PAID, PENDING, CANCELLED, REFUNDED or EXPIRED -- guarded against that
  /// list wherever it is written (see api/admin/registrations/[id]/status).
  ///
  /// EXPIRED is not a synonym for CANCELLED. CANCELLED is a decision somebody
  /// made about an order; EXPIRED is an online checkout nobody ever came back
  /// to finish, swept by src/lib/pending-expiry.ts. The registrants screen has
  /// to be able to tell an organizer which of the two it is looking at, and a
  /// shared word would have made that impossible after the fact.
  ///
  /// Only PAID and PENDING hold a slot (see lib/registration-gate.ts), so the
  /// sweep releases the seat by the act of changing this column.
  status                  String    @default("PAID")
  /// When the sweep expired this order. Null on every row that was never
  /// swept, which is almost all of them.
  ///
  /// It exists for two reasons. It makes the sweep auditable -- an organizer
  /// asking why a registration went away has a timestamp rather than a guess
  /// -- and it is the mark that stops a row being expired twice, which matters
  /// because expiring also hands a promo redemption back and a second pass
  /// would hand back a redemption that was never spent.
  expiredAt               DateTime?
  paymentMethod           String    @default("online")
  checkoutSessionId       String?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  proofOfPayment          String?
  transactionNumber       String?
  /// Whether the customer checked the liability & data-privacy consent box at
  /// submission. false on registrations made before this was required, since
  /// they were never actually asked — not a claim that they refused.
  consentGiven            Boolean   @default(false)
  /// When consentGiven was recorded. Null whenever consentGiven is false.
  consentGivenAt          DateTime?
  /// The full name the person submitting typed as their digital signature,
  /// stored UPPERCASE like every other registrant field. A tick records only
  /// that a box was clicked; a name typed by hand is the thing an organizer
  /// can hold up afterwards and say who agreed.
  ///
  /// It has to match one of the runners on this order (see
  /// lib/consent-signature.ts) rather than any name at all -- one member of a
  /// group registers for everyone, so demanding the *first* runner would stop
  /// whoever is actually doing the paperwork. Null on registrations made
  /// before this was asked for: they were never asked, which is not the same
  /// as having refused.
  consentSignature        String?
  /// What the organizer's payment validator wrote about this order, and who
  /// wrote it when. Internal only -- the runner never sees it and no email
  /// goes out; an assigned staff member reaches out by hand. It is where
  /// "deposit slip is for the wrong amount" lives, so the next person to open
  /// the row does not start the same phone call over again.
  remarks                 String?
  /// Who last wrote the remarks, stored as their name rather than a relation
  /// to the account: it is a line in a log, and it has to keep reading
  /// correctly if that account is later removed.
  remarksBy               String?
  remarksAt               DateTime?
  /// When each of the two transactional emails actually reached the runner --
  /// null means it never did. Resend's free tier is 100 recipients a day and
  /// stops rather than bills, so a send can simply not happen; before these
  /// columns existed sendEmail() logged the failure and returned void, and a
  /// registration could sit unconfirmed with nothing on the row to say so.
  ///
  /// "received" is owed by every registration; "confirmation" only once the
  /// status reaches PAID. A hand-sent email stamps the same column, because
  /// what these record is that the runner *has* the email, not which system
  /// delivered it -- see src/lib/email-delivery.ts.
  receivedEmailSentAt     DateTime?
  confirmationEmailSentAt DateTime?
  /// Resend's own reason for the last failure, kept so a quota stop ("daily
  /// limit reached") is distinguishable from a bad address at a glance. It is
  /// diagnostic text for the organizer, not a coded column.
  lastEmailError          String?
  /// The staff member who sent an outstanding email by hand, and when. Their
  /// name rather than an account id, like remarksBy: it is a line in a log and
  /// has to keep reading correctly after an account is removed.
  manualEmailSentAt       DateTime?
  manualEmailSentBy       String?
  /// When this order was removed from the admin, and by whom (an Organizer or
  /// StaffAccount id — an id rather than a name because the AuditLog row
  /// written beside it already snapshots the name). Null on every live order.
  ///
  /// Removal is soft so the trail has something to point at: an audit row
  /// saying "somebody deleted this order" with nothing left to inspect is half a
  /// trail, and this table holds real customers' registrations. Nothing in the
  /// admin removes a whole order yet — only runners — so the column is here for
  /// the migration to carry once; see STAFF_ACCESS_PLAN.md §4.5.
  deletedAt               DateTime?
  deletedById             String?
  event                   Event     @relation(fields: [eventId], references: [id])
  runners                 Runner[]
}

model Runner {
  id                    String       @id @default(cuid())
  registrationId        String
  /// Which runner on this order, 1..n — the tail of the reference this person
  /// quotes back at us ("RM-D918005C-2"; see src/lib/order-ref.ts). One
  /// orderRef covers a whole group, so without this three colleagues who
  /// registered together have no way to say which of them they are.
  ///
  /// Stored rather than derived from row order: createMany does not guarantee
  /// read-back order, and a reference that changes between two page loads is
  /// worse than none. No default — the position is the checkout route's to
  /// assign, and a default would quietly make everyone runner 1.
  runnerNo              Int
  categoryId            String
  firstName             String
  lastName              String
  email                 String
  phone                 String
  gender                String
  birthdate             String
  singletSize           String
  /// Centavos this runner's category was charged at, when a repricing
  /// promotion gave them a seat at its price -- null when they paid the
  /// category's own price, which is every runner on every other kind of order.
  ///
  /// Per runner rather than per order because a promotion can run out halfway
  /// through one: a group of three on a 10K with two seats left has two
  /// runners at P900 and one at P1,200, and an order-level column could only
  /// record one of those.
  ///
  /// It is a snapshot, like Registration.promoCode, so editing or deleting the
  /// promotion cannot rewrite what somebody was charged -- and it is what the
  /// abandoned-checkout sweep counts to hand the right number of seats back
  /// (src/lib/pending-expiry.ts). Recomputing that from the promotion instead
  /// would hand back three seats for an order that only ever took two.
  promoPrice            Int?
  emergencyContactName  String
  emergencyContactPhone String
  medicalConditions     String?
  /// The club this runner represents. Free text rather than a relation to
  /// RunningCommunity on purpose: it is what they answered on the day, and it
  /// must not change if Run As One's staff later rename or remove that club.
  /// Blank answers are stored as "INDEPENDENT RUNNER", itself a listed option.
  runningCommunity      String       @default("INDEPENDENT RUNNER")
  /// The parent or legal guardian who consented for a runner aged 12 or under
  /// on race day (src/lib/minor-consent.ts), uppercase like every other
  /// registrant name. Null for every runner who did not need consent, and for
  /// rows written before guardian consent existed — those are not backfilled.
  guardianName          String?
  /// "PARENT" | "LEGAL_GUARDIAN", guarded by asGuardianRelationship(). A plain
  /// string rather than an enum, like every other closed vocabulary here.
  guardianRelationship  String?
  /// When the checkout route wrote the guardian's consent — stamped by the
  /// server with the order, never taken from the client.
  guardianConsentAt     DateTime?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
  /// When an organizer or staff member removed this runner, and whose id did
  /// it. Removal used to be a hard DELETE, which left an audit trail pointing
  /// at nothing; now the row stays and every read a person sees filters it out
  /// — the registrants screen, the slot count (a removed runner holds no slot,
  /// exactly as a deleted one did not), the club tally, the emails and the
  /// promotion counts. The AuditLog row beside it carries the name and the
  /// order reference. See STAFF_ACCESS_PLAN.md §4.5.
  deletedAt             DateTime?
  deletedById           String?
  category              Category     @relation(fields: [categoryId], references: [id])
  registration          Registration @relation(fields: [registrationId], references: [id])

  /// Two runners sharing "-2" on the same order would hand two people the
  /// same reference, which is the ambiguity runnerNo exists to remove.
  @@unique([registrationId, runnerNo])
  /// Slot limits are counted by grouping these rows per category, on every
  /// event page and every public listing. Postgres does not index a foreign
  /// key on its own, so without this the count is a sequential scan of every
  /// runner the platform has ever taken.
  @@index([categoryId])
}

/// The running clubs a runner can pick from at sign-up. One master list across
/// every event, because the same clubs turn up race after race.
model RunningCommunity {
  id        String   @id @default(cuid())
  /// Display name, exactly as the runner will see it in the picker.
  name      String
  /// Uppercased `name`, which is what uniqueness is enforced on. Stored rather
  /// than derived so the database itself can reject "Team Army" joining a list
  /// that already has "TEAM ARMY".
  slug      String   @unique
  /// "APPROVED" appears in the runner-facing pickers. "PENDING" is a runner's
  /// write-in only Run As One's staff have seen. Rejecting one deletes it.
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, name])
}

/// A discount an organizer can hand out, redeemed by a runner at checkout.
///
/// Codes used to be organizer-wide and were never wired into checkout at all,
/// which made them admin bookkeeping rather than a discount. Both halves are
/// now real: a code belongs to one event (or to every event the organizer
/// runs), and the checkout routes recompute its value from this row rather
/// than trusting an amount the browser sent -- exactly as they already do with
/// the subtotal and the fees. See src/lib/discount.ts.
model PromoCode {
  id             String               @id @default(cuid())
  /// What the runner types at checkout -- or, when `automatic` is set, the
  /// promotion's own name, since there is nothing to type. One column for both
  /// because both answer the same question: what do we call this promotion
  /// when we show it to a runner. Uppercase like every other coded column, and
  /// spaces are allowed, so "EARLY BIRD" reads correctly on a badge.
  code           String
  /// "CATEGORY_PRICE" | "BUY_X_GET_Y" -- uppercase like every other coded
  /// column, and guarded by asDiscountType at the API door.
  discountType   String
  /// Kept at 0 by both surviving kinds and read by neither: CATEGORY_PRICE
  /// takes its amounts from the categoryPrices rows below and BUY_X_GET_Y from
  /// buyQuantity/getQuantity. The column stays because it is the one place a
  /// future kind whose worth is a single number would put it, and dropping it
  /// would cost a migration to add back.
  discountValue  Int
  /// How many times this code may be redeemed in total. Null = unlimited. A
  /// single-use voucher is simply a limit of 1, which is why there is no
  /// separate flag: "used once" is a cap, and the cap already exists.
  ///
  /// A promotion is limited **either** by this count **or** by the window
  /// below, never by both, and the marketing form makes that an explicit
  /// choice -- see promo-input.ts. There is no column recording which was
  /// chosen because the rows already say it: a usageLimit means the count, and
  /// its absence means the window (or nothing at all). A voucher batch is the
  /// one exception, since every voucher carries a limit of 1 by construction.
  usageLimit     Int?
  usageCount     Int                  @default(0)
  validFrom      DateTime?
  validUntil     DateTime?
  /// The event this code is for. Null means every event this organizer runs,
  /// which is what every code created before scoping existed was.
  eventId        String?
  /// BUY_X_GET_Y only: buy this many at full price and get that many free.
  /// "Register 5, the 6th is free" is buyQuantity 5, getQuantity 1.
  buyQuantity    Int?
  getQuantity    Int?
  /// The batch a bulk-generated voucher was born in ("SUMMER VIP"), so two
  /// hundred single-use codes read as one promotion in the admin instead of
  /// two hundred unrelated rows. Null for a code created on its own.
  batchLabel     String?
  /// A promotion that needs no code: it applies on its own to any order that
  /// meets its conditions. This is what an early bird is -- a discount tied to
  /// a date rather than to something the runner had to be told about. It is
  /// deliberately not offered in the promo box either, since a runner typing
  /// "EARLY BIRD" is not how it is meant to be claimed and it is already on
  /// their order. Where two promotions both apply, only the larger one does --
  /// see bestDiscount in src/lib/discount.ts.
  automatic      Boolean              @default(false)
  /// The organizer's hand on the switch, exactly like Event.registrationPaused
  /// and for the same reason: a promotion that has run out, expired or not
  /// started yet is a fact the app works out for itself, and this one is a
  /// decision -- the dates and the redemptions both remain, and the organizer
  /// has stopped it anyway.
  ///
  /// It is what an organizer reaches for instead of deleting: a code printed
  /// on a poster can be switched off and back on, while deleting it leaves a
  /// runner typing a code nobody can explain.
  paused         Boolean              @default(false)
  organizerId    String
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  event          Event?               @relation(fields: [eventId], references: [id])
  organizer      Organizer            @relation(fields: [organizerId], references: [id])
  /// CATEGORY_PRICE only: the discounted price this promotion puts each
  /// category on. Empty for every other kind.
  categoryPrices PromoCategoryPrice[]

  /// Unique per organizer rather than globally. A code is now looked up
  /// through the event a runner is registering for, so we always know whose it
  /// is -- and a global constraint meant the second organizer to think of
  /// "EARLYBIRD" could not have it.
  @@unique([organizerId, code])
  @@index([eventId])
  @@index([organizerId, batchLabel])
  /// Every event page and both wizards ask for this organizer's automatic
  /// promotions on load, which is the one promo query that runs on a public
  /// page and so the one that has to stay cheap.
  @@index([organizerId, automatic])
}

/// One category put on a lower price by one promotion.
///
/// A CATEGORY_PRICE promotion is not a share or a flat amount off the order --
/// it is a second price list for one race, so the 10K can be cut from P1,200 to
/// P900 while the 5K stays where it is. That is a value per category, which is
/// a row per category rather than a column on PromoCode.
///
/// **Only the discounted price is stored.** The price it is discounted *from*
/// is Category.price, read live, so an organizer who later raises the 10K does
/// not leave a promotion quoting a struck-through number the event page no
/// longer charges. What the runner sees slashed is always the category's own
/// price today.
///
/// Cascades on both sides: the prices are part of the promotion, and a category
/// that no longer exists has no price to discount.
model PromoCategoryPrice {
  id          String    @id @default(cuid())
  promoCodeId String
  categoryId  String
  /// Centavos. Below Category.price, and validated as such at the API door --
  /// a "discount" that costs more is a price rise nobody meant to publish.
  price       Int
  /// How many **runners** may take this price, or null for as many as come.
  ///
  /// Runners rather than orders, unlike PromoCode.usageLimit, and the
  /// difference is the point: this is a number of seats at a price, the same
  /// thing Category.slotLimit counts, so a group of three eats three of them.
  /// An early bird capped at 50 orders could be claimed by 50 groups of four.
  ///
  /// It sits here rather than on PromoCode because that is the whole request:
  /// 50 at the promo price on the 10K and 30 on the 5K are two different
  /// decisions, and one column could only ever hold one of them.
  usageLimit  Int?
  /// Runners already sold at this price. Incremented inside the checkout
  /// transaction by redeemPromoCode, under the same FOR UPDATE lock
  /// reserveSlots takes, since a cap checked before the write is a cap two
  /// simultaneous orders both pass.
  usageCount  Int       @default(0)
  promo       PromoCode @relation(fields: [promoCodeId], references: [id], onDelete: Cascade)
  category    Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  /// One price per category per promotion: a promotion cannot quote the 10K
  /// twice and leave the checkout to pick.
  @@unique([promoCodeId, categoryId])
  @@index([categoryId])
}

model RaceResult {
  id           String   @id @default(cuid())
  eventId      String
  categoryId   String
  bibNumber    String
  name         String
  gender       String
  chipTime     String
  chipTimeSecs Int
  gunTime      String?
  overallRank  Int
  genderRank   Int
  categoryRank Int
  status       String   @default("FINISHED")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  category     Category @relation(fields: [categoryId], references: [id])
  event        Event    @relation(fields: [eventId], references: [id])

  @@unique([eventId, bibNumber])
}

/// One thing a person told us about the app itself.
///
/// Everything else in this schema is about a race. This is the one table that
/// is about the software: a runner who could not get a page to work, an
/// organizer who wants a column the table does not have, anybody with an idea.
/// Nothing in the product reads it — it exists so the platform owner can find
/// out what is wrong without waiting for somebody to send an email, which is
/// the channel it replaced and the reason most of this never reached us.
///
/// It deliberately has no relation to Organizer or Registration. Most feedback
/// arrives from a signed-out runner on a public page, so a foreign key would be
/// null on the majority of rows and would tempt a later reader into thinking a
/// null meant something. Who sent it is the optional `name`/`email` below, kept
/// as the free text they typed.
///
/// Storage: the message is capped at MAX_FEEDBACK_MESSAGE characters and the
/// user agent is truncated on the way in, so a row is under 3 KB in the worst
/// case. Even a thousand of them is a rounding error against the 0.5 GB tier.
model Feedback {
  id        String   @id @default(cuid())
  /// "ISSUE" | "SUGGESTION" | "FEATURE" -- uppercase like every other coded
  /// column, and guarded by asFeedbackKind at the API door. It is what the
  /// sender chose the form's purpose to be, not a category we inferred.
  kind      String
  /// What they actually wrote, exactly as they wrote it. Prose is the one kind
  /// of text this app does not uppercase: the registrant rule in text-case.ts
  /// exists so a name sorts and de-dupes predictably, and a shouted paragraph
  /// is simply harder to read.
  message   String
  /// Who sent it, both optional on purpose. Demanding a name and an address
  /// before someone can report a broken page is how a feedback form ends up
  /// collecting nothing; an anonymous report about a checkout that failed is
  /// still worth more than the silence.
  name      String?
  email     String?
  /// The page they were on when they opened the form, when the entry point
  /// could say. An issue report that does not say where it happened usually
  /// costs a round trip to find out, and by then the person has moved on.
  /// Validated as a same-site path before it is stored -- it arrives in a
  /// query string, so it is somebody else's text until it is checked.
  pagePath  String?
  /// The browser, truncated. "It does not work on my phone" is unactionable;
  /// the same sentence with a Safari build number is a bug we can chase.
  userAgent String?
  /// "NEW" | "REVIEWED" -- the platform owner's own triage mark, so the inbox
  /// can show what has not been read yet. Nothing the sender ever sees, and
  /// deliberately not a workflow: two states are enough to keep a queue.
  status    String   @default("NEW")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// The inbox reads newest-first and filters by triage state, which is the
  /// only query this table has.
  @@index([status, createdAt])
}

// ── Staff accounts, per-event access and the audit trail ──────────────────
//
// An Organizer is a company; these are the people. The Organizer row stays the
// tenant and its own email and password stay the owner's login, so no foreign
// key anywhere above was rewritten to add them. The rule every admin route
// follows: authorisation scopes by the organizer, attribution records the
// person. See STAFF_ACCESS_PLAN.md and src/lib/actor.ts.

/// A person who can sign in to an organizer's admin. Separate from Organizer
/// because an Organizer is a company and a person is not a company: the same
/// human works for more than one of them, and a payment validated on a Sunday
/// has to name the human.
model StaffAccount {
  id                String            @id @default(cuid())
  /// Lowercased on write and on every lookup, like every other account email
  /// in this app — see normalizeAccountEmail in lib/text-case.ts. Checked
  /// against Organizer.email too (findAccountByEmail in lib/actor.ts), since
  /// the database cannot enforce uniqueness across two tables.
  email             String            @unique
  /// Null until the invitation is accepted: an invited person has no password
  /// yet, and the owner never sets one for them.
  password          String?
  name              String
  phone             String?
  /// The person's profile photo, a public blob URL (avatars/ in the public
  /// store), set from /admin/settings. Null shows the name's initial instead.
  avatarUrl         String?
  /// "INVITED" | "ACTIVE" | "SUSPENDED"
  status            String            @default("INVITED")
  /// Base32 TOTP secret, encrypted at rest. Null means 2FA is not set up.
  totpSecret        String?
  totpConfirmedAt   DateTime?
  /// bcrypt hashes, spent one at a time. Never the codes themselves.
  recoveryCodes     String[]          @default([])
  lastLoginAt       DateTime?
  /// Every session issued before this instant is dead. Bumped on password
  /// change, on suspension, and by "sign out everywhere" — the reason it is
  /// needed is that the JWT lives a day and nothing else can end one early.
  sessionsValidFrom DateTime          @default(now())
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  memberships       StaffMembership[]
}

/// One person's place inside one organizer. A join rather than an
/// `organizerId` on StaffAccount because freelance timers, marshals and finance
/// assistants work several organizers' races in a season, and one email should
/// be enough for all of them.
model StaffMembership {
  id              String            @id @default(cuid())
  staffId         String
  organizerId     String
  /// "ADMIN" (every event of this organizer) | "STAFF" (only what is assigned)
  /// | "VIEWER" (a client's own sign-in: registrant counts of its client's
  /// events, and nothing else). Never "OWNER" — the owner is the Organizer row
  /// itself.
  role            String            @default("STAFF")
  /// Who invited them, as a StaffAccount or Organizer id, and when.
  invitedById     String?
  invitedAt       DateTime          @default(now())
  acceptedAt      DateTime?
  /// sha256 of the invite token. The token itself is only ever in the email.
  inviteTokenHash String?
  inviteExpiresAt DateTime?
  /// When this organizer took the person's access away, and who did (a
  /// StaffAccount or Organizer id). Null means not suspended. Per membership
  /// rather than StaffAccount.status because the person may also work another
  /// organizer's races: one owner suspending a freelance timer must not lock
  /// them out of somebody else's event. StaffAccount.status stays the
  /// platform-wide switch, which nothing on the team screen touches.
  suspendedAt     DateTime?
  suspendedById   String?
  /// Set only on a "VIEWER" membership: the client whose events this person
  /// may see the registrant counts of. A VIEWER without one reaches nothing
  /// and its session is refused (lib/actor.ts).
  clientId        String?
  client          Client?           @relation(fields: [clientId], references: [id])
  staff           StaffAccount      @relation(fields: [staffId], references: [id], onDelete: Cascade)
  organizer       Organizer         @relation(fields: [organizerId], references: [id])
  assignments     EventAssignment[]

  @@unique([staffId, organizerId])
  @@index([organizerId])
}

/// Which events a STAFF membership may touch, and as what — the same person can
/// be a validator on one race and only a viewer on another.
model EventAssignment {
  id           String          @id @default(cuid())
  membershipId String
  eventId      String
  /// "EVENT_MANAGER" | "VALIDATOR" | "ENCODER" | "VIEWER" — see lib/permissions.ts.
  role         String
  assignedById String?
  createdAt    DateTime        @default(now())
  membership   StaffMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  event        Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([membershipId, eventId])
  @@index([eventId])
}

/// An organization Run As One runs races for (ADMIN_MERGE_PLAN.md).
///
/// Run As One staff create every event and validate every payment, so an
/// organizer is no longer a tenant with its own dashboard: it is a client, and
/// the people it sends to sign in are VIEWER memberships on Run As One's own
/// Organizer row, pointed here by `StaffMembership.clientId`. The tenant never
/// moves — no Event, Registration or Runner row was rewritten to add this.
///
/// The application columns are what the form at /admin/register collects. They
/// lived on Organizer until ADMIN_MERGE_PLAN.md Batch 3; the migration that
/// added this table copied applicant Organizer rows here with the same id, and
/// Batch 5 dropped the Organizer copies. Nullable because a row written by
/// staff by hand may answer none of it.
///
/// Storage: tens of rows of short text — a rounding error on the 0.5 GB tier.
model Client {
  id                 String            @id @default(cuid())
  /// The organization, as it names itself.
  name               String
  /// Lowercased, like every account email (normalizeAccountEmail). Unique so
  /// one organization cannot collect twice in the submissions list.
  email              String            @unique
  /// NEW | INVITED | ACTIVE | ARCHIVED — lib/client.ts owns the vocabulary and
  /// the moves between them. Plain text so a status needs no migration.
  status             String            @default("NEW")
  /// One of ORGANIZER_TYPES (lib/organizer-application.ts), as on Organizer.
  orgType            String?
  contactFirstName   String?
  contactLastName    String?
  contactRole        String?
  /// E.164 (lib/phone.ts).
  phone              String?
  city               String?
  province           String?
  website            String?
  experience         String?
  services           String[]          @default([])
  firstEventName     String?
  /// YYYY-MM-DD, like Event.date.
  firstEventDate     String?
  firstEventLocation String?
  expectedRunners    String?
  applicationNote    String?
  createdAt          DateTime          @default(now())
  /// When the latest invitation to sign in was sent. Null until staff press
  /// Send invite (Batch 3).
  invitedAt          DateTime?
  updatedAt          DateTime          @updatedAt
  events             Event[]
  viewers            StaffMembership[]
}

/// Money Run As One has paid out to the organizer of one race, or that the
/// organizer has handed back (ADMIN_MERGE_PLAN.md, Batch 6).
///
/// Runners pay Run As One; Run As One keeps the platform and transaction fees
/// and owes the organizer the rest of every PAID order. What is owed is worked
/// out live from the registrations (src/lib/settlement.ts) and is never stored,
/// so a later refund lowers it by itself; this table is only what actually
/// moved. Per event, by the owner's call, because bank accounts are per event.
///
/// **Never edited, never deleted.** A mistake is corrected by voiding the row
/// (`status` VOIDED, with who, when and why) and recording the right one, so
/// the history of what staff said was paid survives its own corrections.
///
/// Storage: one short row per payout — a handful per race.
model Remittance {
  id             String    @id @default(cuid())
  eventId        String
  event          Event     @relation(fields: [eventId], references: [id])
  /// PAYOUT (Run As One → organizer) | RETURN (organizer → Run As One, after a
  /// refund left the organizer overpaid). lib/settlement.ts owns the words.
  kind           String    @default("PAYOUT")
  /// Centavos, always positive; `kind` says which way it went.
  amount         Int
  /// YYYY-MM-DD in Manila, like Event.date: the day the money moved, which is
  /// not the day somebody got round to recording it.
  paidOn         String
  /// BANK_TRANSFER | GCASH | MAYA | CASH | CHECK | OTHER.
  method         String
  /// The bank or e-wallet's reference number, as typed.
  reference      String?
  note           String?
  /// Private blob pathname of the deposit slip or transfer receipt, served only
  /// through a signed URL, like Registration.proofOfPayment.
  proof          String?
  /// RECORDED | VOIDED. Only RECORDED rows count toward what was remitted.
  status         String    @default("RECORDED")
  /// Snapshotted like AuditLog.actorName, so the line keeps its author.
  recordedById   String
  recordedByName String
  createdAt      DateTime  @default(now())
  voidedAt       DateTime?
  voidedById     String?
  voidedByName   String?
  voidReason     String?

  @@index([eventId, createdAt])
}

/// What somebody did. Append-only: nothing in this app updates or deletes one —
/// not the owner, not an admin. See src/lib/audit.ts.
///
/// No relations on purpose. A log row has to outlive the event, the runner and
/// the account it names, and a foreign key would either block those deletions
/// or cascade the evidence away with them.
///
/// Storage: roughly 300–500 bytes a row, so a busy year at 20,000 actions is
/// about 10 MB against the 0.5 GB tier. Retention is 24 months, swept by the
/// cron (Batch 5).
model AuditLog {
  id          String   @id @default(cuid())
  organizerId String
  /// Null for actions that belong to no single race (profile, promotions).
  eventId     String?
  /// "OWNER" | "STAFF" | "SYSTEM" — and "SUPER_ADMIN" on rows written before
  /// the super admin account was retired (ADMIN_MERGE_PLAN.md, Batch 5).
  actorKind   String
  /// The Organizer or StaffAccount id. Null only for SYSTEM (cron, webhook).
  actorId     String?
  /// Snapshotted rather than joined, for the same reason Registration.remarksBy
  /// is a name and not a relation: this is a line in a log and it has to keep
  /// reading correctly after the account behind it is gone.
  actorName   String
  actorEmail  String?
  /// Dotted verb: "registration.status.changed", "runner.deleted",
  /// "proof.viewed". Never free text — the activity screen filters on it, and
  /// the vocabulary is AUDIT_ACTIONS in lib/audit.ts.
  action      String
  entityType  String
  entityId    String?
  /// One sentence, rendered at write time so the screen never has to
  /// reconstruct it: "Marked RM-D918005C as PAID (was PENDING)."
  summary     String
  /// Only the fields that changed: { "status": ["PENDING", "PAID"] }. Never a
  /// whole row, and never a sensitive runner column's value.
  changes     Json?
  ip          String?
  userAgent   String?
  createdAt   DateTime @default(now())

  @@index([organizerId, createdAt])
  @@index([eventId, createdAt])
  @@index([actorId, createdAt])
  @@index([organizerId, action, createdAt])
}

/// Site-wide details Run As One's staff edit from /admin/settings rather than
/// in code. **One row**, keyed "site"; no row yet means every value falls back
/// to its default in lib/site-contact.ts, so the app works before anybody has
/// saved the form. Read through lib/site-settings.ts, never directly.
///
/// Storage: one row of a few dozen bytes.
model SiteSettings {
  id           String   @id @default("site")
  /// The one address the app shows and mails from: the footer, the legal and
  /// help pages, and the sender, reply-to and footer of every email. Stored
  /// exactly as typed after a trim.
  contactEmail String
  /// The footer's social links, one per channel in SOCIAL_CHANNELS
  /// (lib/site-contact.ts), stored with their https:// scheme. Null hides that
  /// channel's icon rather than pointing it anywhere.
  facebookUrl  String?
  instagramUrl String?
  tiktokUrl    String?
  youtubeUrl   String?
  updatedAt    DateTime @updatedAt
}
