                      "insertedContent": {
                        "text": "const event = await prisma.event.findUnique({\n      where: { id: eventId },\n      include: { categories: true }\n    });\n\n    if (!event) {\n      return NextResponse.json({ error: 'Event not found' }, { status: 404 });\n    }\n\n    // Ensure all participants selected a valid category for this event\n    const validCategoryIds = new Set(event.categories.map((c: any) => c.id));\n    const invalidCategory = participants.find((p: any) => !validCategoryIds.has(p.categoryId));\n    if (invalidCategory) {\n      return NextResponse.json({ error: 'Invalid category selected for this event' }, { status: 400 });\n    }\n\n    // A runner 12 or under on race day needs a parent or guardian's name,"
                      }
