          "ruleIndex": 4,
          "level": "warning",
          "message": {
            "text": "Incomplete Logout / Failure to Invalidate JWT on Server Side\n\nThe logout functionality only clears the `admin_token` cookie on the client side, but fails to invalidate the stateless JWT on the server side. An intercepted or stolen JWT can still be used after the user has explicitly logged out."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/app/api/auth/logout/route.ts"
