# Database (Neon Postgres)
# Pooled connection (-pooler host) — used by the app at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?channel_binding=require&sslmode=verify-full"
# Direct connection (no -pooler) — used by Prisma Migrate; DDL cannot run through PgBouncer.
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?channel_binding=require&sslmode=verify-full"

# Signing key for the admin session JWT. Required — the app refuses to start without it.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET=

# Vercel Blob — where event images and payment proofs are stored. Required:
# there is no local-filesystem fallback, because Vercel's disk is read-only and
# a fallback would only hide the failure until deploy day.
#
# TWO stores are needed. A store's access level is fixed when it is created, so
# one store cannot hold both public and private blobs.
#
#   Storage → Create Database → Blob → access: public   (event banners, race kit
#   posters, certificate templates — served straight off the CDN)
BLOB_READ_WRITE_TOKEN=
#   Storage → Create Database → Blob → access: private  (payment receipts, which
#   carry names, amounts and reference numbers)
PROOFS_BLOB_READ_WRITE_TOKEN=

# PayMongo Test API Keys
PAYMONGO_SECRET_KEY=sk_test_...
NEXT_PUBLIC_PAYMONGO_PUBLIC_KEY=pk_test_...
# From the PayMongo dashboard when you register the webhook endpoint.
PAYMONGO_WEBHOOK_SECRET=whsk_...
